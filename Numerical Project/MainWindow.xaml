<Window x:Class="Numerical_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Numerical_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1270">

    <Window.Resources>
        <!-- Tabs Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="RootGrid" Margin="0,0,5,0">
                            <Border x:Name="Border" 
                            Background="#F8FAFC" 
                            BorderBrush="#E2E8F0" 
                            BorderThickness="1,1,1,0" 
                            CornerRadius="8,8,0,0" 
                            Padding="15,8">
                                <ContentPresenter x:Name="ContentSite"
                                        ContentSource="Header"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <Border x:Name="Underline" 
                            Height="3" 
                            Background="Transparent" 
                            VerticalAlignment="Bottom"
                            Margin="2,0,2,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Border" Property="Cursor" Value="Hand"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="Underline" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DataGrid Styling-->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <!-- TextBoxes Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    
        <!-- Buttons Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
        </Style>
    
        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20">
                                <Border x:Name="Box" Background="#F1F5F9" BorderBrush="#CBD5E1" 
                                BorderThickness="1" CornerRadius="5"/>
                                <Path x:Name="Check" Data="M 2,5 L 5,8 L 10,2" Stroke="#3B82F6" 
                              StrokeThickness="2" Visibility="Collapsed" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- For the Project Header -->
            <RowDefinition Height="Auto"/>

            <!-- For the TabControl Tag -->
            <RowDefinition x:Name="TabRow"  Height="Auto"/>

            <!-- For the DataGrid to show the table -->
            <RowDefinition x:Name="GridRow" Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25">
            <TextBlock Text="Numerical Analysis Solver" 
                       FontSize="34" 
                       FontWeight="ExtraBold" 
                       Foreground="#1E293B">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="5" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border Width="80" Height="5" 
                    Background="#3B82F6" 
                    CornerRadius="2.5" 
                    HorizontalAlignment="Center" 
                    Margin="0,8,0,0"/>
        </StackPanel>


        <TabControl Grid.Row="1" Margin="0,0,0,15" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged" HorizontalAlignment="Stretch">
            <!-- Bisection Method -->
            <TabItem Header="Bisection Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtBi_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="Xl (Lower):"/>
                    <TextBox x:Name="txtBisectXl" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Xu (Upper):"/>
                    <TextBox x:Name="txtBisectXu" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtBisectEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Bisection" Padding="10,5" Click="Bisection_Click"/>
                </StackPanel>
            </TabItem>

            <!-- False Position Method -->
            <TabItem Header="False Position Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtFalse_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="Xl (Lower):"/>
                    <TextBox x:Name="txtFPXl" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Xu (Upper):"/>
                    <TextBox x:Name="txtFPXu" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtFPEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate False Position" Padding="10,5" Click="FalsePosition_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Fixed Point Method -->
            <TabItem Header="Fixed-Point Iteration">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtFixed_Equation" Width="180" Margin="5,0,15,0"/>

                    <Label Content="g(X)"/>
                    <TextBox x:Name="txtG_x" Width="180" Margin="5,0,15,0"/>

                    <Label Content="X0:"/>
                    <TextBox x:Name="txtFixedX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtFixedEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Fixed-Point" Click="FixedPoint_Click" Padding="10,5"/>
                </StackPanel>
            </TabItem>

            <!-- Newton Raphson Method -->
            <TabItem Header="Newton Raphson Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtNewtonEquation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="X0:"/>
                    <TextBox x:Name="txtNewtonX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtNewtonEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Newton Raphson" Padding="10,5" Click="Newton_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Secant Method -->
            <TabItem Header="Secant Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtSecant_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="X-1:"/>
                    <TextBox x:Name="txtSecantX_1" Width="60" Margin="5,0,15,0"/>
                    <Label Content="X0:"/>
                    <TextBox x:Name="txtSecantX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtSecantEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Secant Method" Padding="10,5" Click="Secant_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Gauss Elimination -->
            <TabItem x:Name="tabGauss" Header="Gauss Elimination">
                <Grid Margin="10" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Border Style for Matrix -->
                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" BorderBrush="#94A3B8" BorderThickness="2,0,0,0" Margin="-15,0,5,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" 
            BorderBrush="#94A3B8" BorderThickness="0,0,2,0" Margin="5,0,-8,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="0" Content="X1" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Content="X2" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="X3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="Constants" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>

                    <TextBox x:Name="ga11" Grid.Row="1" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="ga12" Grid.Row="1" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="ga13" Grid.Row="1" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gb1" Grid.Row="1" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="ga21" Grid.Row="2" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="ga22" Grid.Row="2" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="ga23" Grid.Row="2" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gb2" Grid.Row="2" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="ga31" Grid.Row="3" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="ga32" Grid.Row="3" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="ga33" Grid.Row="3" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gb3" Grid.Row="3" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <CheckBox x:Name="chkPartialPivot" Grid.Row="4" Grid.ColumnSpan="4" Content="Use Partial Pivoting" Margin="5,10,5,5" HorizontalAlignment="Center" FontWeight="Bold"/>

                    <Button Grid.Row="5" Height="30" Grid.ColumnSpan="4" Content="Calculate Gauss Elimination" FontSize="17" FontWeight="Bold" Click="Gauss_Click"/>
                </Grid>
            </TabItem>

            <!-- LU Decomposition -->
            <TabItem x:Name="tabLU" Header="LU Decomposition">
                <Grid Margin="10" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Border Style for Matrix -->
                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" 
BorderBrush="#94A3B8" BorderThickness="2,0,0,0" Margin="-15,0,5,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" BorderBrush="#94A3B8" BorderThickness="0,0,2,0" Margin="5,0,-8,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="0" Content="X1" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Content="X2" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="X3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="Constants" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>

                    <TextBox x:Name="lu_a11" Grid.Row="1" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a12" Grid.Row="1" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a13" Grid.Row="1" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_b1" Grid.Row="1" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="lu_a21" Grid.Row="2" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a22" Grid.Row="2" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a23" Grid.Row="2" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_b2" Grid.Row="2" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="lu_a31" Grid.Row="3" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a32" Grid.Row="3" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_a33" Grid.Row="3" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="lu_b3" Grid.Row="3" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>
                    <Button Grid.Row="4" Height="30" Grid.ColumnSpan="4" Content="Calculate LU Decomposition" FontSize="17" FontWeight="Bold" Click="LU_Click"/>
                </Grid>
            </TabItem>

            <!-- Crammer's Rule -->
            <TabItem x:Name="tabCramer" Header="Cramer's Rule">
                <Grid Margin="10" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Border Style for Matrix -->
                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" 
BorderBrush="#94A3B8" BorderThickness="2,0,0,0" Margin="-15,0,5,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" 
BorderBrush="#94A3B8" BorderThickness="0,0,2,0" Margin="5,0,-8,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="0" Content="X1" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Content="X2" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="X3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="Constants" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>

                    <TextBox x:Name="a11" Grid.Row="1" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a12" Grid.Row="1" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a13" Grid.Row="1" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b1" Grid.Row="1" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="a21" Grid.Row="2" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a22" Grid.Row="2" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a23" Grid.Row="2" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b2" Grid.Row="2" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="a31" Grid.Row="3" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a32" Grid.Row="3" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a33" Grid.Row="3" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b3" Grid.Row="3" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>
                    <Button Grid.Row="4" Height="30" Grid.ColumnSpan="4" Content="Calculate Crammer" FontSize="17" FontWeight="Bold" Click="Crammer_Click"/>
                </Grid>
            </TabItem>

            <!-- Gauss Jordan -->
            <TabItem x:Name="tabGaussJordan" Header="Gauss Jordan">
                <Grid Margin="10" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Border Style for Matrix -->
                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" 
BorderBrush="#94A3B8" BorderThickness="2,0,0,0" Margin="-15,0,5,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" 
BorderBrush="#94A3B8" BorderThickness="0,0,2,0" Margin="5,0,-8,0">
                        <Grid>
                            <Border VerticalAlignment="Top" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                            <Border VerticalAlignment="Bottom" Height="2" Background="#94A3B8" Width="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Label Grid.Row="0" Grid.Column="0" Content="X1" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Content="X2" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="X3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="Constants" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>

                    <TextBox x:Name="gja11" Grid.Row="1" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="gja12" Grid.Row="1" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="gja13" Grid.Row="1" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gjb1" Grid.Row="1" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="gja21" Grid.Row="2" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="gja22" Grid.Row="2" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="gja23" Grid.Row="2" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gjb2" Grid.Row="2" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="gja31" Grid.Row="3" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="gja32" Grid.Row="3" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="gja33" Grid.Row="3" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="gjb3" Grid.Row="3" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <CheckBox x:Name="chkPartialPivotJordan" Grid.Row="4" Grid.ColumnSpan="4" Content="Use Partial Pivoting" Margin="5,10,5,5" HorizontalAlignment="Center" FontWeight="Bold"/>

                    <Button Grid.Row="5" Height="30" Grid.ColumnSpan="4" Content="Calculate Gauss Jordan" FontSize="17" FontWeight="Bold" Click="GaussJordan_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DataGrid Grid.Row="2" x:Name="dgResults" Background="White" AutoGenerateColumns="True" ColumnWidth="*" AutoGeneratingColumn="dgResults_AutoGeneratingColumn"/>
        
        <!-- Display Result Message -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#80000000" MouseDown="CloseOverlay_Click"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="White" CornerRadius="12" Padding="20"
                    MinWidth="300" MaxWidth="450">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="15" ShadowDepth="3"/>
                </Border.Effect>

                <StackPanel>
                    <Border x:Name="OverlayHeaderColor" Height="6" CornerRadius="3" Background="#3B82F6" Margin="-20,-20,-20,15"/>

                    <TextBlock x:Name="txtOverlayMessage" Text="Message here" 
                               FontSize="16" Foreground="#334155" TextWrapping="Wrap" 
                               TextAlignment="Center" Margin="0,0,0,20"/>

                    <Button Content="OK" Width="100" Height="35" 
                            Background="#3B82F6" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            Click="CloseOverlay_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
