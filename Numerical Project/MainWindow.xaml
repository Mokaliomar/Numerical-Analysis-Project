<Window x:Class="Numerical_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Numerical_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="928">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- For the Project Header -->
            <RowDefinition Height="Auto"/>

            <!-- For the TabControl Tag -->
            <RowDefinition x:Name="TabRow"  Height="Auto"/>

            <!-- For the DataGrid to show the table -->
            <RowDefinition x:Name="GridRow" Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Numerical Analysis Solver" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>


        <TabControl Grid.Row="1" Margin="0,0,0,15" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged" HorizontalAlignment="Stretch">
            <!-- Bisection Method -->
            <TabItem Header="Bisection Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtBi_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="Xl (Lower):"/>
                    <TextBox x:Name="txtBisectXl" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Xu (Upper):"/>
                    <TextBox x:Name="txtBisectXu" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtBisectEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Bisection" Padding="10,5" Click="Bisection_Click"/>
                </StackPanel>
            </TabItem>
            
            <!-- False Position Method -->
            <TabItem Header="False Position Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtFalse_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="Xl (Lower):"/>
                    <TextBox x:Name="txtFPXl" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Xu (Upper):"/>
                    <TextBox x:Name="txtFPXu" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtFPEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate False Position" Padding="10,5" Click="FalsePosition_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Fixed Point Method -->
            <TabItem Header="Fixed-Point Iteration">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtFixed_Equation" Width="180" Margin="5,0,15,0"/>

                    <Label Content="g(X)"/>
                    <TextBox x:Name="txtG_x" Width="180" Margin="5,0,15,0"/>
                    
                    <Label Content="X0:"/>
                    <TextBox x:Name="txtFixedX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtFixedEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Fixed-Point" Click="FixedPoint_Click" Padding="10,5"/>
                </StackPanel>
            </TabItem>
            
            <!-- Newton Raphson Method -->
            <TabItem Header="Newton Raphson Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtNewtonEquation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="X0:"/>
                    <TextBox x:Name="txtNewtonX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtNewtonEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Newton Raphson" Padding="10,5" Click="Newton_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Secant Method -->
            <TabItem Header="Secant Method">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Label Content="Equation"/>
                    <TextBox x:Name="txtSecant_Equation" Width="180" Margin="5,0,15,0"/>
                    <Label Content="X-1:"/>
                    <TextBox x:Name="txtSecantX_1" Width="60" Margin="5,0,15,0"/>
                    <Label Content="X0:"/>
                    <TextBox x:Name="txtSecantX0" Width="60" Margin="5,0,15,0"/>

                    <Label Content="Ea (%):"/>
                    <TextBox x:Name="txtSecantEa" Width="60" Margin="5,0,15,0"/>

                    <Button Content="Calculate Secant Method" Padding="10,5" Click="Secant_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Gauss Elimination -->
            
            <!-- LU Decomposition -->
            
            <!-- Crammer's Rule -->
            <TabItem x:Name="tabCramer" Header="Cramer's Rule">
                <Grid Margin="10" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="X1" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Content="X2" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="X3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="Constants" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Blue"/>

                    <TextBox x:Name="a11" Grid.Row="1" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a12" Grid.Row="1" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a13" Grid.Row="1" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b1" Grid.Row="1" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="a21" Grid.Row="2" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a22" Grid.Row="2" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a23" Grid.Row="2" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b2" Grid.Row="2" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>

                    <TextBox x:Name="a31" Grid.Row="3" Grid.Column="0" Width="50" Margin="5"/>
                    <TextBox x:Name="a32" Grid.Row="3" Grid.Column="1" Width="50" Margin="5"/>
                    <TextBox x:Name="a33" Grid.Row="3" Grid.Column="2" Width="50" Margin="5"/>
                    <TextBox x:Name="b3" Grid.Row="3" Grid.Column="3" Width="50" Margin="5" BorderBrush="Blue"/>
                    <Button Grid.Row="4" Height="30" Grid.ColumnSpan="4" Content="Calculate Crammer" FontSize="17" FontWeight="Bold" Click="Crammer_Click"/>
                </Grid>
            </TabItem>

        </TabControl>
    
        <DataGrid Grid.Row="2" x:Name="dgResults" Background="White" AutoGenerateColumns="True" ColumnWidth="*"/>
    </Grid>

